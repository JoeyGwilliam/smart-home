# Copy this to `.env` (which git ignores) and fill it in. The address stays on this machine.

# Where Morrisons should deliver to. The first address under the postcode that starts with the address line is chosen.
MORRISONS_POSTCODE="AB1 2CD"
MORRISONS_ADDRESS_LINE="1 Example Road"

# Optional: an installed browser to use, such as msedge or chrome. Leave out to use the one that
# `uv run playwright install chromium` downloads.
# MORRISONS_BROWSER_CHANNEL=msedge

# Optional: where the browser keeps the trolley and its login between runs. Defaults to ~/.morrisons_mcp
# MORRISONS_STATE_DIRECTORY=
